{
  "boot-source": {
    "kernel_image_path": "kernelfs/6.18-fc-amd64/vmlinux.bin",
    "boot_args": "reboot=k panic=1 console=ttyS0"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "rootfs/sshd/sshd.ext4",
      "is_root_device": true
    }
  ],
  "network-interfaces": [
    {
      "iface_id": "my_network0",
      "guest_mac": "06:00:AC:10:00:02",
      "host_dev_name": "tap2"
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 1024
  }
}
